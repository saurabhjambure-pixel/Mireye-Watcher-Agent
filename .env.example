# Mireye — sign up at mireye.com with code GROWTH
MIREYE_API_KEY=
MIREYE_BASE_URL=https://api.mireye.com

# Exa — brand-resolution layer (resolves permit contractor/LLC names to retail brands)
EXA_API_KEY=

# LLM provider — used only for extract (LLM #1) and recalibrate (LLM #2)
LLM_PROVIDER=gemini
LLM_PROVIDER_API_KEY=
# Optional: pin a specific Gemini model instead of the "latest flash" alias
# GEMINI_MODEL=gemini-flash-latest

# Cassette mode: unset/0 = replay from /fixtures (default, no network calls to paid APIs)
#                1        = record live calls into /fixtures
RECORD=0
